POSTGRES_PASSWORD=postgres
PAYMENTS_DB_PASSWORD=payments
ADAPTER_DB_PASSWORD=adapter
DATABASE_URL=postgres://payments_api:payments@localhost:5432/payments
ADMIN_TOKEN=change-me-admin-token
SERVICE_TOKEN=change-me-service-token
# base64 of 32 random bytes: openssl rand -base64 32
CREDENTIALS_ENC_KEY=
ADAPTER_URL=http://localhost:3001
QUEUE_DRIVER=pgboss
# psp-adapter should use its own role: postgres://psp_adapter:adapter@localhost:5432/payments
# QUEUE_DATABASE_URL=
# Admin UI login (defaults: admin / admin)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
# Used by `pnpm dev` for psp-adapter (defaults to DATABASE_URL with the psp_adapter role)
# ADAPTER_DATABASE_URL=postgres://psp_adapter:adapter@localhost:5432/payments
